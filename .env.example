# ── App login gate (the app's OWN login — not Watchfire) ──────────────
# The ONLY account allowed to sign in to this app.
APP_ALLOWED_EMAIL=eric.s@mojocarwash.com
# The password for that account. Set the real value as an environment
# secret in production; never commit it. (This file is only a template.)
APP_PASSWORD=change-me

# Random string used to sign session cookies. Generate one, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-too

# ── Runtime ──────────────────────────────────────────────────────────
PORT=3000
# Run the Watchfire browser headless (true) or headed (false, for debugging).
HEADLESS=true
# Optional: path to a Chromium binary if the default launch can't find one.
# CHROMIUM_PATH=/opt/pw-browsers/chromium

# ── AI chat (optional) ───────────────────────────────────────────────
# Needed only for the natural-language "Ask (AI)" panel. Get a key at
# https://console.anthropic.com -> API Keys. Billed separately from Claude.ai.
ANTHROPIC_API_KEY=

# NOTE: Watchfire Ignite credentials are NOT stored here. They are entered
# in the app at runtime and kept only in the server-side session in memory.
